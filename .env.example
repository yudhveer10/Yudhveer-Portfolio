# Public URL used for canonical metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Existing Formspree form ID; replace with your own verified form ID if needed.
NEXT_PUBLIC_FORMSPREE_FORM_ID=xgvnlrrn
# Preferred server-side form ID for /api/enquiry (no secret key).
FORMSPREE_FORM_ID=xgvnlrrn

# Optional. Leave blank until you have real links.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Optional Search Console ownership token. No tracking is activated by this.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
